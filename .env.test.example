# Test host environment
ASPNETCORE_ENVIRONMENT=Test
DOTNET_ENVIRONMENT=Test
Database__Provider=PostgreSQL

# PostgreSQL container values for docker-compose.test.yml
POSTGRES_DB=achinterbank_test
POSTGRES_USER=ach_test
POSTGRES_PASSWORD=example_test_password
POSTGRES_PORT=5433

# Generic connection strings used by tests/API/EF
POSTGRES_TEST_CONNECTION_STRING=Host=localhost;Port=5433;Database=achinterbank_test;Username=ach_test;Password=example_test_password
ConnectionStrings__PostgresConnection=Host=localhost;Port=5433;Database=achinterbank_test;Username=ach_test;Password=example_test_password
ConnectionStrings__AchDbContext=Host=localhost;Port=5433;Database=achinterbank_test;Username=ach_test;Password=example_test_password
