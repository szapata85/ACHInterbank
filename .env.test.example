# Ambiente backend de pruebas
ASPNETCORE_ENVIRONMENT=Testing
DOTNET_ENVIRONMENT=Testing
Database__Provider=Postgres

# Variables PostgreSQL (docker-compose.test.yml)
POSTGRES_DB=achinterbank_test
POSTGRES_USER=ach_test
POSTGRES_PASSWORD=ach_test_password
POSTGRES_PORT=5433

# Connection strings de ejemplo para API/EF
ConnectionStrings__PostgresConnection=Host=localhost;Port=5433;Database=achinterbank_test;Username=ach_test;Password=ach_test_password
ConnectionStrings__AchDatabase=Host=localhost;Port=5433;Database=achinterbank_test;Username=ach_test;Password=ach_test_password
