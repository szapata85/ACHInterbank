  "baseline_findings": [
    "CustomerThirdParty models one customer + destination institution + destination account + recipient id with Pending/Active/Rejected status.",
    "AchTransactionService and AchBulkTransactionService silently create/enrich Customer and CustomerAccount records.",
    "PrenotificationHandler silently creates/links CustomerThirdParty only for prenotification and only when source account resolves to an internal Customer.",
    "AchStateTransitionService maps AppliedTacitly/Certified to Active and ReturnedByOperator/ReturnedByEpr to Rejected for the linked CustomerThirdParty.",
    "CustomerThirdPartiesController exposes GET only in the baseline.",
    "Transaction SPA requests status=Active from /api/customer-third-parties to populate destination accounts.",
    "ClearingHouseTransactionRule already contains chamber-specific prenotification and receiver-identification policy fields.",
    "PrenotificationQueryService contains a global +3 business-day maturity calculation.",
    "AchTacitAcceptanceJobHandler uses SlaDeadlineAtUtc or effective-date fallback for pending prenotifications.",
    "RegulatoryCatalogSeeder ACH Colombia ClearingHouseTransactionRule metadata references V32 and requires audit against V35."
  ],
