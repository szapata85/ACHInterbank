    <xs:complexType>
      <xs:sequence>
        <xs:element name="codigo" type="xs:string" minOccurs="1" maxOccurs="1" />
        <xs:element name="valor" type="xs:decimal" minOccurs="0" maxOccurs="1" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
