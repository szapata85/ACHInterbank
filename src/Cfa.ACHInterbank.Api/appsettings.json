      "SoapAction": "http://tempuri.org/IWSCFAACH/Proc_Contrapartidas",
      // Modo operacional inicializado para Proc_Contrapartidas.
      "OperatingMode": "Live",
      // Timeout del método SOAP en segundos.
      "TimeoutSeconds": 15,
      // Autoriza registrar/habilitar la operación al configurar endpoint; no prueba conectividad.
      "Enabled": true
    },
    // Definición del procedimiento SOAP de procesamiento de transacciones.
    "ProcTransacciones": {
      // URL del servicio de transacciones; vacío hasta provisión autorizada.
      "Endpoint": "",
      // SOAPAction exigido por contrato para Proc_Transacciones.
      "SoapAction": "http://tempuri.org/IWSCFAACH/Proc_Transacciones",
      // Modo operacional inicializado para Proc_Transacciones.
      "OperatingMode": "Live",
      // Timeout del método SOAP en segundos.
      "TimeoutSeconds": 15,
      // Habilita esta operación en el catálogo de bootstrap.
      "Enabled": true
    },
    // Definición del procedimiento SOAP de recepción de respuesta de transacciones.
    "RegistrarRespuestaTransaccion": {
      // URL de servicio de recepción de respuestas; vacío hasta ser autorizado.
