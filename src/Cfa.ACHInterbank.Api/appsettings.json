  "DigitalEnvelope": {
    "NachaExport": {
      "Environment": "Test",
      "RecipientPurpose": "OutboundEncryption",
      "RecipientHolderType": "ClearingHouse",
      "AllowDefaultClearingHouseFallback": false,
      "DefaultClearingHouseId": 1
    },
    "EnabledClearingHouseIds": [],
    "CertificateResolver": {
      "UseCertificateManagement": false,
      "AllowLegacyCertificateFallback": true,
      "FailIfCertificateManagementUnavailable": false,
      "Environment": "Test",
      "DefaultClearingHouseId": 1,
      "PreferActiveCertificateManagementVersion": true,
      "LogCertificateSource": true,
      "AllowHistoricalDecryptWhenExpired": true,
      "AllowHistoricalDecryptWhenRevoked": false
