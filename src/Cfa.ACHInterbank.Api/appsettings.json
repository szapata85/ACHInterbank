  "SoapIntegrationBootstrap": {
    // Activa servicio de inicialización de parámetros SOAP.
    "Enabled": false,
    // Limita la configuración inicializada a modo Live.
    "EnforceLiveOnly": true,
    // Si es true reemplaza parámetros existentes en BD; false preserva ajustes actuales.
    "OverwriteExistingSettings": false,
    // Timeout SOAP predeterminado (segundos) cuando no hay uno específico.
