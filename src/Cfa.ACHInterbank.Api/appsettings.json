    "CertificateSecretResolver": {
      "EnableInMemoryProvider": true,
      "EnableExternalSecretReferenceProvider": true,
      "EnableKeyVaultProvider": false,
      "EnableHsmProvider": false,
      "FailIfSecretProviderUnavailable": false,
      "MaskSecretRefInLogs": true,
      "DisableInMemoryProviderInProduction": true
    },
    "SignatureValidation": {
      "EnableSignatureValidation": true,
      "FailCloseOnInvalidSignature": true,
      "FailWhenSignerCertificateMissing": true,
      "FailWhenSignerCertificateExpired": true,
      "ValidateSignerCertificateThumbprint": false,
      "ValidateSignerCertificateChain": false,
      "AllowLegacyUnsignedEnvelope": false,
      "LogSignatureValidationDetails": true,
      "AuditInvalidSignature": true,
      "Environment": "Test"
    }
