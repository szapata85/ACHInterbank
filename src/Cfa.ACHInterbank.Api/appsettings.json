    "OutboundPath": ".runtime/achcol-mft/outbound",
    // Ruta donde ingresan archivos recibidos de la cámara.
    "InboundPath": ".runtime/achcol-mft/inbound",
    // Ruta temporal para archivos que se están procesando.
