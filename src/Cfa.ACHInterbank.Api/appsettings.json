  "DigitalEnvelope": {
    "EnabledClearingHouseIds": [],
    "CertificateResolver": {
      "UseCertificateManagement": false,
      "AllowLegacyCertificateFallback": true,
      "FailIfCertificateManagementUnavailable": false,
      "Environment": "Test",
      "DefaultClearingHouseId": 1,
      "PreferActiveCertificateManagementVersion": true,
      "LogCertificateSource": true,
      "AllowHistoricalDecryptWhenExpired": true,
      "AllowHistoricalDecryptWhenRevoked": false
    },
    "CertificateSecretResolver": {
      "EnableInMemoryProvider": true,
      "EnableExternalSecretReferenceProvider": true,
      "EnableKeyVaultProvider": false,
      "EnableHsmProvider": false,
      "FailIfSecretProviderUnavailable": false,
      "MaskSecretRefInLogs": true,
      "DisableInMemoryProviderInProduction": true
    },
    "OpenBao": {
      "Enabled": false,
      "BaseUrl": "http://openbao:8200",
      "KvMount": "secret",
      "CertificatesPrefix": "certificates",
      "ApiToken": "",
      "ApiTokenFilePath": "/openbao-bootstrap/api-token",
      "TimeoutSeconds": 10
    },
    "SignatureValidation": {
      "EnableSignatureValidation": true,
      "FailCloseOnInvalidSignature": true,
      "FailWhenSignerCertificateMissing": true,
      "FailWhenSignerCertificateExpired": true,
      "ValidateSignerCertificateThumbprint": false,
      "ValidateSignerCertificateChain": false,
      "AllowLegacyUnsignedEnvelope": false,
      "LogSignatureValidationDetails": true,
      "AuditInvalidSignature": true,
      "Environment": "Test"
    }
  },
  "Database": {
    "Provider": "Postgres"
