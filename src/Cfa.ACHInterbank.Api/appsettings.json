  "NachaGeneration": {
    "Mode": "HYBRID",
    "EnableType7TableDriven": true,
    "FailOnResolverAmbiguity": false,
    "Type7DisableLegacyFallbackForLayouts": [],
    "Type7EnableTableDrivenForClearingHouses": [
      "ACH",
      "CENIT"
    ],
    "Type7RolloutPolicyEnabled": true,
    "Type7RequireShadowBeforeDisableFallback": true,
    "Type7MinQualifiedRuns": 10,
    "Type7MinEquivalencePercent": 99.5,
    "Type7CriticalFieldCodes": [
      "R7_ADDENDATYPE",
      "R7_RETURNCODE"
    ],
    "Type7DisableFallbackEnvironments": [
      "Development",
      "Production"
    ]
  },
  "IncomingNacha": {
    "DispatchResilience": {
      "MaxAttempts": 5,
      "InitialBackoffSeconds": 120,
      "MaxBackoffSeconds": 1800,
      "BackoffMultiplier": 2.0,
      "EnableJitter": false,
      "JitterMaxSeconds": 15
    }
  },
  "ProcContrapartidas": {
    "Mode": "DryRun"
  },
  "NachaInboundSimulator": {
    "Enabled": false,
    "Mode": "Disabled",
    "AllowExternalTransmission": false,
    "RequireSyntheticData": true,
    "AllowAutoImport": false,
