  // Administración del ciclo de vida de certificados digitales.
  "CertificateManagement": {
    // Anticipación (días) para advertir vencimiento de certificados.
    "ExpirationWarningDays": 30
  },
  // Controles de cifrado, resolución de certificados y verificación de firmas de sobres digitales.
  "DigitalEnvelope": {
    // Criterios del certificado destinatario para exportar archivos NACHA protegidos.
    "NachaExport": {
      // Entorno de certificados para exportación (Test/producción según registro configurado).
      "Environment": "Test",
      // Propósito requerido para el certificado del destinatario.
      "RecipientPurpose": "OutboundEncryption",
      // Tipo de titular del certificado de destino.
      "RecipientHolderType": "ClearingHouse",
      // Permite resolver por cámara predeterminada cuando falte una cámara explícita.
      "AllowDefaultClearingHouseFallback": false,
      // ID de cámara para fallback, si la política anterior está habilitada.
      "DefaultClearingHouseId": 1
    },
    // Cámaras habilitadas para operaciones del sobre; revisar el significado de lista vacía en el resolver.
    "EnabledClearingHouseIds": [
    ],
    // Política de búsqueda y compatibilidad de certificados del sobre.
    "CertificateResolver": {
      // Consulta el módulo nuevo de gestión de certificados para resolverlos.
      "UseCertificateManagement": false,
      // Admite certificados heredados si el resolvedor nuevo no encuentra uno.
      "AllowLegacyCertificateFallback": true,
      // Detiene resolución cuando el módulo nuevo no está disponible.
      "FailIfCertificateManagementUnavailable": false,
      // Entorno requerido al buscar certificados.
      "Environment": "Test",
      // Identificador de cámara usado como predeterminado si aplica fallback.
      "DefaultClearingHouseId": 1,
      // Prioriza la versión activa registrada en gestión de certificados.
      "PreferActiveCertificateManagementVersion": true,
      // Registra procedencia del certificado seleccionado (sin material secreto).
      "LogCertificateSource": true,
      // Permite descifrar archivos históricos con certificados ya vencidos.
      "AllowHistoricalDecryptWhenExpired": true,
      // Permite o prohíbe descifrado histórico con certificados revocados.
      "AllowHistoricalDecryptWhenRevoked": false
    },
    // Fuentes admitidas para obtener referencias o material secreto de certificados.
    "CertificateSecretResolver": {
      // Habilita proveedor en memoria (orientado a escenarios controlados).
      "EnableInMemoryProvider": true,
      // Admite referencia a secreto gestionado externamente.
      "EnableExternalSecretReferenceProvider": true,
      // Habilita proveedor de Azure Key Vault cuando exista integración configurada.
      "EnableKeyVaultProvider": false,
      // Habilita integración con módulo de seguridad hardware HSM.
      "EnableHsmProvider": false,
      // Falla ante indisponibilidad de proveedor de secreto.
      "FailIfSecretProviderUnavailable": false,
      // Oculta referencias sensibles en el registro de eventos.
      "MaskSecretRefInLogs": true,
      // Bloquea proveedor de memoria en ambiente Production.
      "DisableInMemoryProviderInProduction": true
    },
    // Políticas de verificación de firmas de sobres digitales.
    "SignatureValidation": {
      // Activa validación criptográfica de firmas.
      "EnableSignatureValidation": true,
      // Rechaza la operación si la firma es inválida.
      "FailCloseOnInvalidSignature": true,
      // Falla si no se dispone del certificado del firmante.
      "FailWhenSignerCertificateMissing": true,
      // Falla si está vencido el certificado del firmante.
      "FailWhenSignerCertificateExpired": true,
      // Habilita comprobación de huella digital contra política configurada.
      "ValidateSignerCertificateThumbprint": false,
      // Habilita validación de la cadena de confianza del firmante.
      "ValidateSignerCertificateChain": false,
      // Permite compatibilidad con sobres antiguos sin firma; evaluar riesgo.
      "AllowLegacyUnsignedEnvelope": false,
      // Registra detalles técnicos de la validación de firmas.
      "LogSignatureValidationDetails": true,
      // Genera auditoría ante firma no válida.
      "AuditInvalidSignature": true,
      // Entorno usado por la verificación de firmas.
      "Environment": "Test"
    }
  },
  // Proveedor y procedimientos de inicio de base de datos.
  "Database": {
    // Motor de persistencia seleccionado: SqlServer o PostgreSQL cuando el despliegue lo soporte.
    "Provider": "SqlServer",
    // Si es true, EF Core aplica migraciones pendientes al iniciar; evitar simultaneidad en producción.
    "ApplyMigrations": false,
    // Si es true, carga datos semilla configurados; desactivado por defecto.
    "ApplySeed": false
  },
  // Cadenas para conexión con bases de datos; no almacenar credenciales reales en control de versiones.
  "ConnectionStrings": {
    // Cadena de conexión PostgreSQL, utilizada si Database.Provider selecciona Postgres.
    "PostgresConnection": "",
    // Cadena de conexión SQL Server para API, migraciones EF y Quartz persistente.
    "SqlConnection": "Server=127.0.0.1,1433;Database=ACHInterbank;User Id=sa;Password=Admin123!Sql2026;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  // Opciones de generación NACHA-M, mapeos Type 7 y control de compatibilidad.
  "NachaGeneration": {
    // Estrategia de generación de archivos; TABLE_DRIVEN usa tablas/reglas de configuración.
    "Mode": "TABLE_DRIVEN",
    // Contexto operacional de generación; LIVE no es un simulador.
    "ExecutionScope": "LIVE",
    // Autoriza modo CENIT sin homologación solo en desarrollo controlado.
    "AllowNonHomologatedCenitDevelopment": false,
    // Marca aprobación de la nomenclatura externa de archivos ACH Colombia.
    "AchColExternalNamingHomologated": false,
    // Habilita motor basado en tablas para registros de adenda tipo 7.
    "EnableType7TableDriven": true,
    // Falla si el resolvedor encuentra más de una configuración candidata.
    "FailOnResolverAmbiguity": false,
    // Diseños Type 7 donde se prohíbe usar generador heredado.
    "Type7DisableLegacyFallbackForLayouts": [
    ],
    // Cámaras donde se habilita el generador Type 7 basado en tablas.
    "Type7EnableTableDrivenForClearingHouses": [
      "ACH",
      "CENIT"
    ],
    // Activa controles de habilitación progresiva para Type 7.
    "Type7RolloutPolicyEnabled": true,
    // Exige comparación shadow antes de retirar fallback heredado.
    "Type7RequireShadowBeforeDisableFallback": true,
    // Número mínimo de pruebas calificadas para avalar el cambio Type 7.
    "Type7MinQualifiedRuns": 10,
    // Porcentaje mínimo de equivalencia para la transición Type 7.
    "Type7MinEquivalencePercent": 99.5,
    // Campos Type 7 críticos que requieren comparación/equivalencia.
    "Type7CriticalFieldCodes": [
      "R7_ADDENDATYPE",
      "R7_RETURNCODE"
    ],
    // Ambientes donde se deshabilita fallback según política Type 7.
    "Type7DisableFallbackEnvironments": [
      "Development",
      "Production"
    ]
  },
  // Políticas de tolerancia a fallos para solicitudes a servicios externos.
  "Resilience": {
    // Políticas por categoría de cliente HTTP administrado.
    "ExternalHttp": {
      // Consulta HTTP de salud de endpoints, con reintentos acotados.
      "HealthProbe": {
        // Tiempo máximo (segundos) de una prueba de salud HTTP.
        "TimeoutSeconds": 5,
        // Máximo de reintentos permitidos en pruebas de salud.
        "MaxRetryAttempts": 2,
        // Espera base entre reintentos de salud, en milisegundos.
        "RetryBaseDelayMilliseconds": 200,
        // Proporción de fallas que abre el circuito de protección.
        "CircuitBreakerFailureRatio": 0.5,
        // Ventana de observación del circuit breaker, en segundos.
        "CircuitBreakerSamplingDurationSeconds": 30,
        // Volumen mínimo de solicitudes para evaluar la apertura del circuito.
        "CircuitBreakerMinimumThroughput": 5,
        // Duración (segundos) del circuito abierto tras fallas.
        "CircuitBreakerBreakDurationSeconds": 30,
        // Máximo de operaciones de salud HTTP concurrentes.
        "BulkheadPermitLimit": 20,
        // Máximo de operaciones esperando un permiso de concurrencia.
        "BulkheadQueueLimit": 20
      },
      // Política HTTP genérica para clientes externos.
      "Generic": {
        // Tiempo máximo (segundos) por llamada HTTP genérica.
        "TimeoutSeconds": 100,
        // Reintentos de llamada HTTP genérica (cero para evitar repetición).
        "MaxRetryAttempts": 0
      },
      // Política de llamadas SOAP; no reintentar automáticamente operaciones financieras.
      "Soap": {
        // Timeout adicional de resiliencia SOAP (cero = sin timeout adicional de esta política).
        "TimeoutSeconds": 0,
        // Reintentos de operaciones SOAP (cero para evitar duplicados).
        "MaxRetryAttempts": 0
      }
    }
  },
  // Parámetros de procesamiento de archivos NACHA recibidos.
  "IncomingNacha": {
    // Reintentos internos de entrega/procesamiento de entradas NACHA.
    "DispatchResilience": {
      // Número máximo de intentos de despacho.
      "MaxAttempts": 5,
      // Espera inicial antes de reintentar, en segundos.
      "InitialBackoffSeconds": 120,
      // Espera máxima acumulada entre reintentos, en segundos.
      "MaxBackoffSeconds": 1800,
      // Multiplicador del retardo entre intentos.
      "BackoffMultiplier": 2.0,
      // Introduce variación aleatoria al intervalo de reintentos.
      "EnableJitter": false,
      // Variación máxima del retardo, en segundos.
      "JitterMaxSeconds": 15
    }
  },
  // Modo operacional del procedimiento SOAP de contrapartidas.
  "ProcContrapartidas": {
    // Modo Live/alternativo usado por el procedimiento; Live requiere endpoint y autorización válidos.
    "Mode": "Live"
  },
  // Modo operacional del procedimiento SOAP de transacciones.
  "ProcTransacciones": {
    // Modo Live/alternativo usado por el procedimiento; no implica transmisión por sí solo.
    "Mode": "Live"
  },
  // Simulador NACHA entrante solo para pruebas aisladas; dejar deshabilitado en producción.
  "NachaInboundSimulator": {
    // Activa/desactiva el simulador de archivos NACHA.
    "Enabled": false,
    // Modalidad de simulación; Disabled impide ejecutarlo por defecto.
    "Mode": "Disabled",
    // Permite transmisión externa desde pruebas (mantener false salvo autorización explícita).
    "AllowExternalTransmission": false,
    // Exige datos sintéticos en simulaciones.
    "RequireSyntheticData": true,
    // Autoriza importar automáticamente respuestas simuladas.
    "AllowAutoImport": false,
    // Habilita respuestas diferenciales de casos de prueba.
    "DifferentialResponsesEnabled": false,
    // Exige perfil diferencial publicado antes de simular.
    "RequirePublishedDifferentialProfile": true,
    // Carpeta de salida de evidencias de simulación.
    "OutputDirectory": "docs/uat/evidencias/nacha-m-inbound-simulator/generated",
    // Número máximo de registros por simulación.
    "MaxEntriesPerSimulation": 10,
    // Cámaras permitidas para simulación (solo pruebas).
    "AllowedClearingHouses": [
      "ACHCOL",
      "CENIT"
    ]
  },
  // Scheduler de trabajos recurrentes ACH/CENIT; persiste en SQL Server.
  "Quartz": {
    // Nombre lógico del scheduler compartido por sus instancias.
    "SchedulerName": "ACHInterbankScheduler",
    // Identificador de instancia; AUTO lo genera automáticamente para clúster.
    "InstanceId": "AUTO",
    // Identificador legible de la instancia de aplicación; revisar que sea único si el código lo requiere.
    "InstanceName": "achinterbank-api",
    // Cantidad máxima de jobs que el scheduler puede ejecutar en paralelo.
    "MaxConcurrency": 10,
    // Máximo de triggers adquiridos por lote.
    "MaxBatchSize": 10,
    // Margen (ms) de disparo adelantado para adquisición de triggers.
    "BatchFireAheadMilliseconds": 0,
    // Realiza adquisición de triggers con bloqueo transaccional.
    "AcquireTriggersWithinLock": true,
    // Intervalo de señal de vida de la instancia, en segundos.
    "InstanceHeartbeatSeconds": 10,
    // Umbral (segundos) para considerar una instancia fuera de línea.
    "OfflineThresholdSeconds": 45,
    // Persistencia de triggers/jobs Quartz y recuperación tras reinicios.
    "JobStore": {
      // Modo del job store; Persistent guarda jobs/triggers en la BD.
      "Mode": "Persistent",
      // Proveedor del job store, consistente con el motor real de BD.
      "Provider": "SqlServer",
      // Prefijo de tablas del esquema Quartz (QRTZ_).
      "TablePrefix": "QRTZ_",
      // Habilita uso compartido del job store por instancias coordinadas.
      "Clustered": true,
      // Intervalo de comprobación del clúster Quartz, en segundos.
      "ClusterCheckinIntervalSeconds": 10,
      // Retraso mínimo (ms) desde el que se evalúa un disparo perdido.
      "MisfireThresholdMilliseconds": 60000,
      // Verifica estructura de tablas Quartz antes de operar.
      "PerformSchemaValidation": true
    }
  },
