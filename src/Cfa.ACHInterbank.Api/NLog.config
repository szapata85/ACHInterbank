<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off"
      internalLogFile="c:\temp\nlog-internal.log">

  <variables>
    <variable name="LogFolder" value="C:\\Logs\\ACHInterbank"/>
  </variables>
  

  <targets>
    <target xsi:type="File"
            name="LogData"
            fileName="C:\\Logs\\ACHInterbank.log"
            archiveFileName="C:\\Logs\\ACHInterbank\\archive\\ACHInterbank_${longdate}.log"
            archiveEvery="Day"
            archiveAboveSize="5MB"  maxArchiveFiles="10"    layout="${longdate} ${uppercase:${level}} ${message}" />
  </targets>

  <rules>
    <logger name="LogFile" minlevel="Debug" writeTo="LogData" />
  </rules>
</nlog>