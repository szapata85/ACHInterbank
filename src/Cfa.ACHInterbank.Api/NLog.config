<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogToConsole="true">
  <!-- Un unico destino fisico. NLog archiva y limpia automaticamente los historicos. -->
  <targets>
    <!-- El procesamiento de disco se hace fuera del hilo de la solicitud HTTP.
         Block evita perder errores si se llena la cola; no es completamente no bloqueante bajo saturacion. -->
    <target xsi:type="AsyncWrapper" name="LogData" queueLimit="10000" batchSize="200" overflowAction="Block">
      <target xsi:type="File"
              fileName="${basedir}/logs/ACHInterbank.log"
              archiveFileName="${basedir}/logs/archive/ACHInterbank.log"
              archiveSuffixFormat="_{1:yyyyMMdd}_{0:00}"
              archiveEvery="Day"
              archiveAboveSize="10485760"
              maxArchiveFiles="30"
              maxArchiveDays="60"
              createDirs="true"
              keepFileOpen="true"
              layout="${longdate} | ${uppercase:${level}} | ${logger} | ${message} ${exception:format=tostring}" />
    </target>
    <!-- Log SOAP con envelopes originales sin ocultar valores ni truncarlos.
         La cola se limita para reducir presión de memoria de XML potencialmente grandes.
         Discard evita bloquear transferencias, pero puede perder eventos diagnósticos. -->
    <target xsi:type="AsyncWrapper" name="SoapEnvelopeData" queueLimit="256" batchSize="50" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${basedir}/logs/ACHInterbank.SOAP.log"
              archiveFileName="${basedir}/logs/archive/ACHInterbank.SOAP.log"
              archiveSuffixFormat="_{1:yyyyMMdd}_{0:00}"
              archiveEvery="Day"
              archiveAboveSize="10485760"
              maxArchiveFiles="30"
              maxArchiveDays="60"
              createDirs="true"
              keepFileOpen="true"
              layout="${longdate} | ${uppercase:${level}} | ${logger} | ${message}" />
    </target>
  </targets>
  <rules>
    <!-- Exclusivo SOAP: no duplicar envelopes en ACHInterbank.log. -->
    <logger name="Cfa.ACHInterbank.External.Connections.SoapEnvelopeJournal" minlevel="Info" writeTo="SoapEnvelopeData" final="true" />
    <!-- El logger heredado conserva el umbral Debug y evita escritura duplicada. -->
    <logger name="LogFile" minlevel="Debug" writeTo="LogData" final="true" />
    <logger name="*" minlevel="Info" writeTo="LogData" />
  </rules>
</nlog>
