# Runtime defaults are intentionally non-secret.
DATABASE_PROVIDER=Postgres
DATABASE_APPLY_MIGRATIONS=true
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ENABLE_HTTPS_REDIRECTION=false

# SQL Server runtime
MSSQL_PID=Developer
SQLSERVER_HOST_PORT=1433
MSSQL_SA_PASSWORD=

# PostgreSQL runtime
POSTGRES_DB=ACHInterbank
POSTGRES_USER=example_user
POSTGRES_PASSWORD=

# Optional direct connection strings
CONNECTIONSTRINGS__SQLCONNECTION=
CONNECTIONSTRINGS__POSTGRESCONNECTION=
