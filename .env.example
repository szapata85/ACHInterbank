# PostgreSQL
POSTGRES_DB=ACHInterbank
POSTGRES_USER=sa
POSTGRES_PASSWORD=change-me

# API runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ENABLE_HTTPS_REDIRECTION=false

# OpenBao (UAT token; do not commit real values)
OPENBAO_API_TOKEN=
OPENBAO_KV_MOUNT=secret
OPENBAO_CERTIFICATES_PREFIX=certificates
