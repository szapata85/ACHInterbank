# Runtime defaults are intentionally non-secret.
DATABASE_PROVIDER=SqlServer
DATABASE_APPLY_MIGRATIONS=true
DATABASE_APPLY_SEED=true
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ENABLE_HTTPS_REDIRECTION=false

# SQL Server runtime
MSSQL_PID=Developer
MSSQL_DB=ACHInterbank
SQLSERVER_HOST_PORT=1433
MSSQL_SA_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA

QUARTZ_CLUSTERED=false
RATE_LIMITING_PERMIT_LIMIT=10
RATE_LIMITING_WINDOW_SECONDS=1
RATE_LIMITING_QUEUE_LIMIT=2
