# PostgreSQL
POSTGRES_DB=ACHInterbank
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password_change_me
POSTGRES_HOST_PORT=5432

# API runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ENABLE_HTTPS_REDIRECTION=false

# OpenBao UAT bootstrap (token API se genera automáticamente en volumen compartido)
# Do not commit real OpenBao tokens. Use a vault, secret manager or secure runtime injection.
OPENBAO_API_TOKEN=
OPENBAO_KV_MOUNT=secret
OPENBAO_CERTIFICATES_PREFIX=certificates
OPENBAO_POLICY_NAME=ach-api
WAIT_FOR_OPENBAO_TIMEOUT_SECONDS=90
